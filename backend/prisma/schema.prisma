generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  PELICULA
  SERIE
  ANIME
  MANGA
  VIDEOJUEGO
  COMIC
}

model Media {
  id        Int       @id @default(autoincrement())
  tmdbId    Int?
  titulo    String
  tituloOriginal String? // original_title de TMDB, no cambia con el idioma. Base del slug de la URL.
  tipo      MediaType
  anio      Int?
  portada   String?   // Portada COMPARTIDA (valor por defecto de TMDB/IGDB para quien no ha personalizado nada)
  backdrop  String?   // Banner COMPARTIDO, mismo criterio que portada
  sinopsis  String?
  remakeOfTmdbId Int?
  remakeChecked  Boolean @default(false)
  igdbId    Int?      @unique // un juego solo puede tener UNA fila (evita duplicados como los que tuvimos que limpiar a mano)
  sinopsisTraducciones Json? // caché: { "es-ES": "texto ya traducido", "fr-FR": "..." }
  createdAt DateTime  @default(now())
  gameLogs  GameLog[]
  watchLogs WatchLog[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  isAdmin   Boolean  @default(false) // solo el/los administradores pueden editar colecciones curadas a mano (borrar, reordenar, añadir juegos)
  isPrivate Boolean  @default(false) // si true, seguirte requiere aceptación tuya, y tu catálogo/listas/reseñas solo las ven tus seguidores aceptados (o tú mismo)
  idioma    String   @default("es-ES") // idioma preferido: título/sinopsis/cast en las peticiones a TMDB
  region    String   @default("ES")    // región preferida: usada para plataformas de streaming (JustWatch vía TMDB)
  createdAt DateTime @default(now())
  gameLogs  GameLog[]
  watchLogs WatchLog[]
  siguiendo  Follow[] @relation("Siguiendo")  // a quién sigo yo (yo soy followerId)
  seguidores Follow[] @relation("Seguidores") // quién me sigue a mí (yo soy followingId)
}

// --- SEGUIR USUARIOS ("Friends") ---
// Directo (estado ACCEPTED automático) si el destino tiene cuenta pública;
// si el destino es privado, se crea en PENDING y hace falta que él la
// acepte/rechace (ver /follow-requests/:followerId/accept|decline) antes de
// contar como seguidor de verdad para nada (ni contador, ni ver contenido).
model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int // quien sigue
  followingId Int // a quien se sigue
  estado      String   @default("ACCEPTED") // "PENDING" | "ACCEPTED"
  createdAt   DateTime @default(now())

  follower  User @relation("Siguiendo", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Seguidores", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // no puedes seguir dos veces al mismo usuario
}

// --- NOTIFICACIONES (campana del navbar) ---
// Sin relación formal a User/List en el schema (a propósito, igual que
// Follow/ListLike hacen con userId suelto en otros sitios) — se resuelve el
// nombre/avatar del actor y el nombre de la lista consultando aparte en el
// endpoint, así una notificación puede sobrevivir aunque luego se borre la
// lista en cuestión (solo pierde el enlace, no la notificación en sí).
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      // quién LA RECIBE
  tipo      String   // 'FOLLOW' | 'LIST_LIKE'
  actorId   Int      // quién la generó (quien sigue / quien da like)
  listId    Int?     // solo rellenado si tipo = 'LIST_LIKE'
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UserMedia {
  lastActivityAt DateTime?
  id            Int      @id @default(autoincrement())
  userId        Int
  mediaId       Int
  watched       Boolean  @default(false)
  liked         Boolean  @default(false)
  watchlist     Boolean  @default(false)
  rating        Int?     // Nota personal, ej. de 1 a 10
  customPoster  String?  // Portada elegida por ESTE usuario para este medio (no afecta a los demás)
  customBackdrop String? // Banner elegido por ESTE usuario para este medio (no afecta a los demás)
  playStatus    String?  // Solo videojuegos: "PLAYING" | "COMPLETED" | "RETIRED" | "SHELVED" | "ABANDONED" | null
  updatedAt     DateTime @updatedAt

  @@unique([userId, mediaId]) // Un usuario solo puede tener UN estado por película
}

model List {
  id        Int        @id @default(autoincrement())
  userId    Int
  nombre    String
  privada   Boolean    @default(false) // si true, SOLO el dueño puede verla — ni siquiera tus seguidores aceptados
  modo      String     @default("GRID") // "RANKED" | "GRID" — Ranked numera las posiciones, Grid no
  ordenPor  String     @default("MANUAL") // "MANUAL" (orden que arrastras a mano) | "NOMBRE" | "FECHA" (fecha en que se añadió) | "NOTA_MEDIA" | "MI_NOTA"
  ordenDireccion String @default("DESC") // "ASC" | "DESC"
  createdAt DateTime   @default(now())
  items     ListItem[]
  likes     ListLike[]
}

model ListItem {
  id        Int      @id @default(autoincrement())
  listId    Int
  mediaId   Int
  orden     Int      @default(0) // posición cuando ordenPor = "MANUAL" (arrastrar y soltar)
  createdAt DateTime @default(now()) // para poder ordenar por "fecha en que se añadió"
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId]) // No repetir la misma película en la misma lista
}

// --- "ME GUSTA" EN LISTAS DE OTROS USUARIOS ---
// Le da el corazón a una lista ajena para que aparezca en tu propio "My
// Lists", en un apartado nuevo aparte de las que tú has creado. No borra ni
// copia nada de la lista original — sigue siendo de su dueño, tú solo
// guardas una referencia a ella.
model ListLike {
  id        Int      @id @default(autoincrement())
  userId    Int      // quien le ha dado al corazón
  listId    Int
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId]) // no puedes darle al corazón dos veces a la misma lista
}

model Favorite {
  id      Int @id @default(autoincrement())
  userId  Int
  mediaId Int
  orden   Int

  @@unique([userId, mediaId])
}

model GameLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  mediaId     Int
  nombre      String    @default("Log")
  plataforma  String?
  jugadoEn    String?
  propiedad   String?
  fechaInicio DateTime?
  fechaFin    DateTime?
  edicion     String?   // "Edition played" (Standard, Deluxe, GOTY... texto libre)
  minutosJugados Int?   // "total played", guardado en minutos (horas/minutos se combinan en el frontend)
  rating      Int?
  review      String?
  spoilers    Boolean   @default(false)
  orden       Int       @default(0)
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
}

// --- COLECCIONES DE VIDEOJUEGOS CURADAS A MANO ---
// La primera vez que se pide la saga de un juego (GET /igdb/collection/:igdbId)
// y no existe todavía ninguna CuratedCollection para él, se calcula igual que
// hasta ahora a partir de IGDB y el resultado se guarda aquí como semilla. A
// partir de ese momento, esa saga siempre se sirve desde estas tablas (ya no
// se vuelve a consultar IGDB para ella), y solo un administrador puede
// editarla: borrar juegos, reordenarlos (arrastrar y soltar) o añadir otros
// nuevos con el buscador.
model CuratedCollection {
  id        Int                     @id @default(autoincrement())
  nombre    String                  // nombre de la saga, p. ej. "Resident Evil"
  createdAt DateTime                @default(now())
  items     CuratedCollectionItem[]
}

model CuratedCollectionItem {
  id           Int      @id @default(autoincrement())
  collectionId Int
  igdbId       Int      // id del juego en IGDB (no siempre estará ya guardado en Media)
  titulo       String
  anio         Int?
  portada      String?
  cancelado    Boolean  @default(false) // true = va en el apartado "Cancelados"
  esOtro       Boolean  @default(false) // true = va en el apartado "Other" (grupo libre definido a mano por el admin)
  orden        Int      @default(0)     // controla el orden dentro de la saga (arrastrar y soltar)
  createdAt    DateTime @default(now())

  collection CuratedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, igdbId]) // un juego no puede estar repetido dentro de la misma saga
}

// --- REGISTROS DE VISIONADO (películas/series) ---
// Igual que GameLog para juegos, pero simplificado: solo lo necesario para
// el modal "Review or log..." (fecha de visionado, reseña libre, y si es un
// rewatch). Permite varios registros por usuario+película, para poder marcar
// varios visionados en fechas distintas.
model WatchLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  mediaId     Int
  fechaVisto  DateTime  @default(now()) // "Watched on"
  review      String?                   // "Add a review..."
  rewatch     Boolean   @default(false) // "I've watched this before"
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
}