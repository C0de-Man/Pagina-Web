generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  PELICULA
  SERIE
  ANIME
  MANGA
  VIDEOJUEGO
  COMIC
}

model Media {
  id        Int       @id @default(autoincrement())
  tmdbId    Int?
  titulo    String
  tituloOriginal String? // original_title de TMDB, no cambia con el idioma. Base del slug de la URL.
  tipo      MediaType
  anio      Int?
  portada   String?
  backdrop  String?   // Campo para la imagen horizontal de fondo
  sinopsis  String?
  remakeOfTmdbId Int?
  remakeChecked  Boolean @default(false)
  igdbId    Int?      @unique // un juego solo puede tener UNA fila (evita duplicados como los que tuvimos que limpiar a mano)
  sinopsisTraducciones Json? // caché: { "es-ES": "texto ya traducido", "fr-FR": "..." }
  createdAt DateTime  @default(now())
  gameLogs  GameLog[]
  watchLogs WatchLog[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  isAdmin   Boolean  @default(false) // solo el/los administradores pueden editar colecciones curadas a mano (borrar, reordenar, añadir juegos)
  idioma    String   @default("es-ES") // idioma preferido: título/sinopsis/cast en las peticiones a TMDB
  region    String   @default("ES")    // región preferida: usada para plataformas de streaming (JustWatch vía TMDB)
  createdAt DateTime @default(now())
  gameLogs  GameLog[]
  watchLogs WatchLog[]
}

model UserMedia {
  id            Int      @id @default(autoincrement())
  userId        Int
  mediaId       Int
  watched       Boolean  @default(false)
  liked         Boolean  @default(false)
  watchlist     Boolean  @default(false)
  rating        Int?     // Nota personal, ej. de 1 a 10
  customPoster  String?  // Portada elegida por este usuario para este medio
  playStatus    String?  // Solo videojuegos: "PLAYING" | "COMPLETED" | "RETIRED" | "SHELVED" | "ABANDONED" | null
  updatedAt     DateTime @updatedAt

  @@unique([userId, mediaId]) // Un usuario solo puede tener UN estado por película
}

model List {
  id        Int        @id @default(autoincrement())
  userId    Int
  nombre    String
  createdAt DateTime   @default(now())
  items     ListItem[]
}

model ListItem {
  id      Int  @id @default(autoincrement())
  listId  Int
  mediaId Int
  list    List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId]) // No repetir la misma película en la misma lista
}

model Favorite {
  id      Int @id @default(autoincrement())
  userId  Int
  mediaId Int
  orden   Int

  @@unique([userId, mediaId])
}

model GameLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  mediaId     Int
  nombre      String    @default("Log")
  plataforma  String?
  jugadoEn    String?
  propiedad   String?
  fechaInicio DateTime?
  fechaFin    DateTime?
  edicion     String?   // "Edition played" (Standard, Deluxe, GOTY... texto libre)
  minutosJugados Int?   // "total played", guardado en minutos (horas/minutos se combinan en el frontend)
  rating      Int?
  review      String?
  spoilers    Boolean   @default(false)
  orden       Int       @default(0)
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
}

// --- COLECCIONES DE VIDEOJUEGOS CURADAS A MANO ---
// La primera vez que se pide la saga de un juego (GET /igdb/collection/:igdbId)
// y no existe todavía ninguna CuratedCollection para él, se calcula igual que
// hasta ahora a partir de IGDB y el resultado se guarda aquí como semilla. A
// partir de ese momento, esa saga siempre se sirve desde estas tablas (ya no
// se vuelve a consultar IGDB para ella), y solo un administrador puede
// editarla: borrar juegos, reordenarlos (arrastrar y soltar) o añadir otros
// nuevos con el buscador.
model CuratedCollection {
  id        Int                     @id @default(autoincrement())
  nombre    String                  // nombre de la saga, p. ej. "Resident Evil"
  createdAt DateTime                @default(now())
  items     CuratedCollectionItem[]
}

model CuratedCollectionItem {
  id           Int      @id @default(autoincrement())
  collectionId Int
  igdbId       Int      // id del juego en IGDB (no siempre estará ya guardado en Media)
  titulo       String
  anio         Int?
  portada      String?
  cancelado    Boolean  @default(false) // true = va en el apartado "Cancelados"
  esOtro       Boolean  @default(false) // true = va en el apartado "Other" (grupo libre definido a mano por el admin)
  orden        Int      @default(0)     // controla el orden dentro de la saga (arrastrar y soltar)
  createdAt    DateTime @default(now())

  collection CuratedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, igdbId]) // un juego no puede estar repetido dentro de la misma saga
}

// --- REGISTROS DE VISIONADO (películas/series) ---
// Igual que GameLog para juegos, pero simplificado: solo lo necesario para
// el modal "Review or log..." (fecha de visionado, reseña libre, y si es un
// rewatch). Permite varios registros por usuario+película, para poder marcar
// varios visionados en fechas distintas.
model WatchLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  mediaId     Int
  fechaVisto  DateTime  @default(now()) // "Watched on"
  review      String?                   // "Add a review..."
  rewatch     Boolean   @default(false) // "I've watched this before"
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
}