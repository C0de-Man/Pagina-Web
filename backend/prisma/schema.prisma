generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  PELICULA
  SERIE
  ANIME
  MANGA
  VIDEOJUEGO
  COMIC
}

model Media {
  id        Int       @id @default(autoincrement())
  tmdbId    Int?
  titulo    String
  tipo      MediaType
  anio      Int?
  portada   String?
  backdrop  String?   // Campo para la imagen horizontal de fondo
  sinopsis  String?
  createdAt DateTime  @default(now())
}