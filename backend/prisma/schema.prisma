generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  PELICULA
  SERIE
  MANGA
  LIBRO
  VIDEOJUEGO
  COMIC
}

model Media {
  id        Int       @id @default(autoincrement())
  tmdbId    Int?
  titulo    String
  tituloOriginal String? // original_title de TMDB, no cambia con el idioma. Base del slug de la URL.
  tipo      MediaType
  anio      Int?
  portada   String?   // Portada COMPARTIDA (valor por defecto de TMDB/IGDB para quien no ha personalizado nada)
  backdrop  String?   // Banner COMPARTIDO, mismo criterio que portada
  sinopsis  String?
  remakeOfTmdbId Int?
  remakeChecked  Boolean @default(false)
  igdbId    Int?      @unique // un juego solo puede tener UNA fila (evita duplicados como los que tuvimos que limpiar a mano)
  googleBooksId String? @unique // id de Google Books
  mangaDexId    String? @unique // id de MangaDex (UUID, string) — se mantiene como respaldo
  malMangaId    Int?    @unique // id de manga en MyAnimeList (API oficial v2)
  sinopsisTraducciones Json? // caché: { "es-ES": "texto ya traducido", "fr-FR": "..." }
  createdAt DateTime  @default(now())
  gameLogs  GameLog[]
  watchLogs WatchLog[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  isAdmin   Boolean  @default(false) // solo el/los administradores pueden editar colecciones curadas a mano (borrar, reordenar, añadir juegos)
  isPrivate Boolean  @default(false) // si true, seguirte requiere aceptación tuya, y tu catálogo/listas/reseñas solo las ven tus seguidores aceptados (o tú mismo)
  idioma    String   @default("es-ES") // idioma preferido: título/sinopsis/cast en las peticiones a TMDB
  region    String   @default("ES")    // región preferida: usada para plataformas de streaming (JustWatch vía TMDB)
  createdAt DateTime @default(now())
  gameLogs  GameLog[]
  watchLogs WatchLog[]
  siguiendo  Follow[] @relation("Siguiendo")  // a quién sigo yo (yo soy followerId)
  seguidores Follow[] @relation("Seguidores") // quién me sigue a mí (yo soy followingId)
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  estado      String   @default("ACCEPTED")
  createdAt   DateTime @default(now())

  follower  User @relation("Siguiendo", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Seguidores", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  tipo      String
  actorId   Int
  listId    Int?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UserMedia {
  lastActivityAt DateTime?
  id            Int      @id @default(autoincrement())
  userId        Int
  mediaId       Int
  watched       Boolean  @default(false)
  liked         Boolean  @default(false)
  watchlist     Boolean  @default(false)
  rating        Int?     // Nota personal, ej. de 1 a 10
  customPoster  String?  // Portada elegida por ESTE usuario para este medio (no afecta a los demás)
  customBackdrop String? // Banner elegido por ESTE usuario para este medio (no afecta a los demás)
  playStatus    String?  // Juegos: "PLAYING"|"COMPLETED"|"RETIRED"|"SHELVED"|"ABANDONED" — Series: "WATCHING"|"PAUSED"|"ABANDONED"
  progresoActual Int?     // CAPÍTULO actual (libros/manga)
  progresoTotal  Int?     // CAPÍTULO total, escrito a mano por ti
  progresoVolumenActual Int? // VOLUMEN actual (solo relevante en manga)
  progresoVolumenTotal  Int? // VOLUMEN total, escrito a mano por ti
  updatedAt     DateTime @updatedAt

  @@unique([userId, mediaId]) // Un usuario solo puede tener UN estado por película
}

model List {
  id        Int        @id @default(autoincrement())
  userId    Int
  nombre    String
  privada   Boolean    @default(false)
  modo      String     @default("GRID")
  ordenPor  String     @default("MANUAL")
  ordenDireccion String @default("DESC")
  createdAt DateTime   @default(now())
  items     ListItem[]
  likes     ListLike[]
}

model ListItem {
  id        Int      @id @default(autoincrement())
  listId    Int
  mediaId   Int
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
}

model ListLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  listId    Int
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

model Favorite {
  id      Int @id @default(autoincrement())
  userId  Int
  mediaId Int
  orden   Int

  @@unique([userId, mediaId])
}

model GameLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  mediaId     Int
  nombre      String    @default("Log")
  plataforma  String?
  jugadoEn    String?
  propiedad   String?
  fechaInicio DateTime?
  fechaFin    DateTime?
  edicion     String?
  minutosJugados Int?
  rating      Int?
  review      String?
  spoilers    Boolean   @default(false)
  orden       Int       @default(0)
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
}

model CuratedCollection {
  id        Int                     @id @default(autoincrement())
  nombre    String
  createdAt DateTime                @default(now())
  items     CuratedCollectionItem[]
}

model CuratedCollectionItem {
  id           Int      @id @default(autoincrement())
  collectionId Int
  igdbId       Int
  titulo       String
  anio         Int?
  portada      String?
  cancelado    Boolean  @default(false)
  esOtro       Boolean  @default(false)
  orden        Int      @default(0)
  createdAt    DateTime @default(now())

  collection CuratedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, igdbId])
}

model CuratedMovieCollection {
  id               Int      @id @default(autoincrement())
  tmdbCollectionId Int?     @unique
  tmdbSeriesId     Int?     @unique
  nombre           String
  createdAt        DateTime @default(now())
  items            CuratedMovieCollectionItem[]
}

model CuratedMovieCollectionItem {
  id           Int      @id @default(autoincrement())
  collectionId Int
  tmdbId       Int
  tipo         String   @default("PELICULA")
  titulo       String
  anio         Int?
  portada      String?
  orden        Int      @default(0)
  createdAt    DateTime @default(now())

  collection CuratedMovieCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, tmdbId, tipo])
}

model CinematicUniverse {
  id        Int                          @id @default(autoincrement())
  nombre    String
  createdAt DateTime                     @default(now())
  items     CinematicUniverseItem[]
  fuentes   CinematicUniverseSource[]
  fases     CinematicUniversePhase[]
}

model CinematicUniverseItem {
  id            Int       @id @default(autoincrement())
  universeId    Int
  tmdbId        Int
  tipo          String    @default("PELICULA")
  titulo        String
  anio          Int?
  fechaEstreno  DateTime?
  portada       String?
  pestaña       String
  orden         Int       @default(0)
  ordenUniverso Int?
  faseId        Int?
  fase          CinematicUniversePhase? @relation(fields: [faseId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  universe CinematicUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, tmdbId, tipo])
}

model CinematicUniverseSource {
  id         Int      @id @default(autoincrement())
  universeId Int
  tipo       String
  tmdbId     Int
  createdAt  DateTime @default(now())

  universe CinematicUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, tipo, tmdbId])
}

model CinematicUniversePhase {
  id         Int      @id @default(autoincrement())
  universeId Int
  nombre     String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())

  universe CinematicUniverse       @relation(fields: [universeId], references: [id], onDelete: Cascade)
  items    CinematicUniverseItem[]
}

model WatchLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  mediaId     Int
  fechaVisto  DateTime  @default(now())
  review      String?
  rewatch     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
}

model UserSeasonWatch {
  id           Int       @id @default(autoincrement())
  userId       Int
  mediaId      Int
  seasonNumber Int
  watched      Boolean   @default(false)
  rating       Int?
  customPoster String?
  fechaVisto   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, mediaId, seasonNumber])
}

model UserEpisodeWatch {
  id            Int       @id @default(autoincrement())
  userId        Int
  mediaId       Int
  seasonNumber  Int
  episodeNumber Int
  watched       Boolean   @default(false)
  rating        Int?
  fechaVisto    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, mediaId, seasonNumber, episodeNumber])
}